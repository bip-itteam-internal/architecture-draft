      "seed": 1517858317,
      "version": 1489,
      "versionNonce": 1745096045,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760671897660,
      "link": null,
      "locked": false,
      "text": "When user login they will see this\n\nLanding page with basic information\n-> Work schedule and shift\n-> Attendance status\n-> Others\n\nLeft side there is other system portal\nUser able to access it immediately\n\nWhen clicked it will refresh this page and\nleave the left tab alone since it doesn't\nneed reloading because\n\nFront-end will need to limit access to\nwhat user can see based on their roles",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When user login they will see this\n\nLanding page with basic information\n-> Work schedule and shift\n-> Attendance status\n-> Others\n\nLeft side there is other system portal\nUser able to access it immediately\n\nWhen clicked it will refresh this page and\nleave the left tab alone since it doesn't\nneed reloading because\n\nFront-end will need to limit access to\nwhat user can see based on their roles",
      "autoResize": true,
      "lineHeight": 1.25
    },
