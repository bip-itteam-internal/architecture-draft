    <participant id="Participant_0s6sfgk" name="Employee is late to office process" processRef="Process_0n782ip" />
    <textAnnotation id="TextAnnotation_0qtwgw8">
      <text>Open discussion, for adjustment because of system failure or want to request pardon for attendance status</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0k1g17s">
      <text>This include the previous attendance status and their excuse/additional docs required to pardon them</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_021evzk">
      <text>Will received +1 late counter (reset at 26 each month)</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_1ndgmoy">
      <text>Guest book will have note regarding the late</text>
    </textAnnotation>
