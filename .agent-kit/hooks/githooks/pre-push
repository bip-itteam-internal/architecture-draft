#!/bin/sh
# pre-push — gerbang lokal agent-kit untuk repo kode DAN vault. Dipasang lewat `git config core.hooksPath`
# oleh init (path absolut, berlaku untuk seluruh worktree repo itu). Dijalankan oleh sh bawaan
# git, termasuk di Windows (Git for Windows), jadi satu skrip untuk semua OS.
#
# Menolak push bila pemeriksaan dasar gagal:
#   - repo Node (package.json + pnpm-lock.yaml): pnpm tsc, pnpm lint, pnpm build
#       (build dilewati bila AGENTKIT_SKIP_BUILD=1, dan itu DICETAK supaya tidak senyap)
#   - repo Go multi-modul (services/<x>/go.mod): `go build ./...` per service yang tersentuh
#       oleh commit yang dipush; semua service bila shared-library tersentuh
#   - vault agent-kit (.agent-kit/ di akar): test MILIK KIT SENDIRI, tetapi HANYA bila push-nya
#       menyentuh .agent-kit/ atau Tools/ (ADR 0077 par 4; aturannya di hooks/gerbang-kit.py).
#       Push dokumentasi biasa keluar seketika. Lewati sadar: AGENTKIT_SKIP_KIT_TESTS=1
# Test vs baseline SENGAJA tidak di sini (menit-menitan); itu urusan /judge.
# Melewati dengan sadar: `git push --no-verify` (jejaknya tetap ada di riwayat shell Anda).

remote="$1"
top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$top" || exit 0

zero="0000000000000000000000000000000000000000"
touched=""
# ⛔ Daftar berkas yang TIDAK BISA ditentukan harus menyalakan gerbang, bukan mematikannya.
# `$rsha` adalah tip remote yang sesungguhnya, dan itu bisa commit yang BELUM kita punya (remote
# sudah maju dan belum di-fetch). `git diff <commit asing> <lsha>` lalu gagal diam-diam, daftar
# berkasnya kosong, dan tiap cabang di bawah membaca kosong itu sebagai "tidak ada yang
# tersentuh" lalu melewati pemeriksaannya. Terukur 2026-09-21: push yang memuat perubahan
# .agent-kit/ dilaporkan "gerbang test kit DILEWATI". Kelas yang sama dengan nol-gerbang-lolos
# yang sedang ditutup rilis ini, cuma satu lapis lebih awal.
tak_tentu=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue                      # hapus branch remote: tak ada yang diperiksa
  if [ "$rsha" = "$zero" ]; then
    base="$(git merge-base "$lsha" origin/main 2>/dev/null || git merge-base "$lsha" origin/master 2>/dev/null || echo "")"
  else
    base="$rsha"
  fi
  if [ -n "$base" ] && git cat-file -e "${base}^{commit}" 2>/dev/null; then
    touched="$touched
$(git diff --name-only "$base" "$lsha" 2>/dev/null)"
  else
    tak_tentu=1
    touched="$touched
$(git show --name-only --format= "$lsha" 2>/dev/null)"
  fi
done
if [ "$tak_tentu" -eq 1 ]; then
  echo "[agent-kit pre-push] daftar berkas tersentuh tidak bisa ditentukan sepenuhnya (basis diff tidak ada di sini): memeriksa SEMUA, bukan melewati"
fi

gagal=0
echo "[agent-kit pre-push] repo: $top"

# ---- Node (erp-frontend dkk) ----
if [ -f package.json ] && [ -f pnpm-lock.yaml ]; then
  for s in tsc typecheck lint; do
    if grep -q "\"$s\"[[:space:]]*:" package.json; then
      echo "[agent-kit pre-push] pnpm $s ..."
      if ! pnpm "$s"; then echo "[agent-kit pre-push] GAGAL: pnpm $s"; gagal=1; fi
    fi
  done
  if [ "$gagal" -eq 0 ] && grep -q "\"build\"[[:space:]]*:" package.json; then
    if [ "${AGENTKIT_SKIP_BUILD:-0}" = "1" ]; then
      echo "[agent-kit pre-push] pnpm build DILEWATI (AGENTKIT_SKIP_BUILD=1). Jalankan sendiri sebelum merge."
    else
      echo "[agent-kit pre-push] pnpm build ... (lewati sadar: AGENTKIT_SKIP_BUILD=1)"
      if ! pnpm build; then echo "[agent-kit pre-push] GAGAL: pnpm build"; gagal=1; fi
    fi
  fi
fi

# ---- Go multi-modul (bip-erp) ----
if [ -d services ] && ls services/*/go.mod >/dev/null 2>&1; then
  svcs=""
  if [ "$tak_tentu" -eq 1 ] || printf '%s\n' "$touched" | grep -q '^shared-library/'; then
    svcs="$(ls -d services/*/ | sed 's#services/##; s#/$##')"
    echo "[agent-kit pre-push] shared-library tersentuh: build SEMUA service"
  else
    svcs="$(printf '%s\n' "$touched" | sed -n 's#^services/\([^/]*\)/.*#\1#p' | sort -u)"
  fi
  if [ -z "$svcs" ]; then
    echo "[agent-kit pre-push] tidak ada services/<x> tersentuh: go build dilewati"
  fi
  for s in $svcs; do
    [ -f "services/$s/go.mod" ] || continue
    echo "[agent-kit pre-push] go build services/$s ..."
    if ! (cd "services/$s" && go build ./...); then echo "[agent-kit pre-push] GAGAL: go build services/$s"; gagal=1; fi
  done
fi

# ---- vault agent-kit (architecture-draft): test milik kit sendiri ----
# Nama berkas dok vault berisi SPASI, jadi daftarnya dioper lewat berkas, bukan argumen: kata
# yang terpecah di sini membuat saringan path meleset dan gerbangnya menyala untuk push dok.
if [ -f .agent-kit/hooks/gerbang-kit.py ]; then
  py=""
  for c in "Tools/.venv/Scripts/python.exe" "Tools/.venv/bin/python"; do
    [ -x "$c" ] && py="$c" && break
  done
  [ -z "$py" ] && for c in py python3 python; do
    command -v "$c" >/dev/null 2>&1 && py="$c" && break
  done
  if [ -z "$py" ]; then
    echo "[agent-kit pre-push] TIDAK ADA python untuk menjalankan gerbang test kit. Gerbang GAGAL, bukan dilewati."
    echo "[agent-kit pre-push] Lewati sadar: AGENTKIT_SKIP_KIT_TESTS=1 git push"
    gagal=1
  else
    daftar="$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/agentkit-push-$$")"
    printf '%s\n' "$touched" > "$daftar"
    paksa=""
    [ "$tak_tentu" -eq 1 ] && paksa="--paksa"
    if ! "$py" .agent-kit/hooks/gerbang-kit.py --vault "$top" --berkas-file "$daftar" $paksa; then gagal=1; fi
    rm -f "$daftar"
  fi
fi

if [ "$gagal" -ne 0 ]; then
  echo "[agent-kit pre-push] PUSH DITOLAK. Perbaiki dulu, atau lewati sadar dengan --no-verify."
  exit 1
fi
echo "[agent-kit pre-push] lolos"
exit 0
